# OpenAI API key (required for embeddings whenever FAISS is enabled - the
# default; the custom endpoint below replaces OpenAI only for context/answer
# generation, not embeddings)
OPENAI_API_KEY=sk-your-api-key-here

# Storage path for projects (optional, defaults to ~/.konte). Index files are
# recorded when written and checked before they are read.
STORAGE_PATH=~/.konte

# Whether that check refuses the index (enforce), logs and loads it anyway
# (warn), or does not run (off). Optional, defaults to enforce.
# INDEX_INTEGRITY=enforce

# Manifest of index digests (optional). Commit it with the indexes it covers
# and every checkout verifies one record, with no key to distribute.
# INDEX_MANIFEST=konte-index.lock

# Key the signatures are made with when no manifest anchors them (optional).
# Unset generates one in the storage root as .signing-key, mode 0600. Set it
# where that root is shared and the key should not live on it.
# INDEX_SIGNING_KEY=

# Embedding model (optional)
EMBEDDING_MODEL=text-embedding-3-small

# Context generation model (optional)
CONTEXT_MODEL=gpt-4.1-mini

# Serving (optional). The API and UI keep opened projects in memory instead of
# reading one back from disk per request. PRELOAD_PROJECTS opens the listed
# projects at startup ("*" for all) so the first request does not wait for it.
# PROJECT_CACHE_SIZE=4
# PRELOAD_PROJECTS=

# Build concurrency (optional). One ceiling on requests in flight for the whole
# build: context generation across all segments, and embedding requests. Lower
# it for an endpoint with a tight rate limit, raise it for one that can take it.
# MAX_CONCURRENT_CALLS=16

# BM25 query preprocessing (optional). Reducing a question to content words
# before lexical search is a large gain for Korean, and costs one LLM call per
# distinct query. Turn it off for retrieval that never leaves memory.
# BM25_KEYWORD_EXTRACTION=true
# KEYWORD_EXTRACTION_TIMEOUT=5.0   # seconds before falling back to tokenization

# Custom chat endpoint (any OpenAI-compatible server: vLLM, Ollama, LM Studio, ...)
# When both LLM_BASE_URL and LLM_MODEL are set, context generation and answer
# generation use that endpoint instead of OpenAI.
#
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=optional-api-key

# Reranker (optional - a server exposing a vLLM-style /score endpoint)
# Required only when querying with rerank=True.
#
# RERANKER_BASE_URL=https://your-endpoint/v1
# RERANKER_MODEL=your-reranker-model
# RERANKER_VERIFY_SSL=true
