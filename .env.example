# OpenAI API key (required for embeddings whenever FAISS is enabled - the
# default; a custom backend below replaces OpenAI only for context/answer
# generation, not embeddings)
OPENAI_API_KEY=sk-your-api-key-here

# Storage path for projects (optional, defaults to ~/.konte)
STORAGE_PATH=~/.konte

# Embedding model (optional)
EMBEDDING_MODEL=text-embedding-3-small

# Context generation model (optional)
CONTEXT_MODEL=gpt-4.1-mini

# Custom Backend (any vLLM server with an OpenAI-compatible API)
# When both BACKENDAI_ENDPOINT and BACKENDAI_MODEL_NAME are set,
# context generation and answer generation use the custom backend instead of OpenAI.
#
# BACKENDAI_ENDPOINT=https://your-vllm-endpoint/v1
# BACKENDAI_MODEL_NAME=your-model-name
# BACKENDAI_API_KEY=optional-api-key

# Reranker (optional - vLLM server exposing a /score endpoint)
# Required only when querying with rerank=True.
#
# RERANKER_BASE_URL=https://your-vllm-endpoint/v1
# RERANKER_MODEL=Qwen3-Reranker-8B
# RERANKER_VERIFY_SSL=true
